{
  "name": "fn_Dim_Deal",
  "kind": "m",
  "expression": [
    "(",
    "    pAdjustmentOrNonAdjustment as text,",
    "    pBusinessGroup as text,",
    "    pMaxReportingDate as nullable number,",
    "    DebugStatus as text ",
    ") as text =>",
    "",
    "let",
    "    MaxDatePart =",
    "        if pMaxReportingDate = null then",
    "            \"CALCULATE (",
    "                MAX ( 'REPORTING DATE'[ID] ),",
    "                ALL ( 'REPORTING DATE' )",
    "            )\"",
    "        else",
    "            Text.From(pMaxReportingDate),",
    "",
    "    SourceFilterPart =",
    "        if pAdjustmentOrNonAdjustment = \"Adjustements\" then",
    "            \"SOURCE[SOURCEGROUP NAME] = \"\"Adjustements\"\"\"",
    "        else",
    "            \"SOURCE[SOURCEGROUP NAME] <> \"\"Adjustements\"\"\",",
    "",
    "",
    "BusinessGroupList =",
    "    let",
    "        items = Text.Split(pBusinessGroup, \",\"),",
    "        quoted = List.Transform(items, each \"\"\"\" & Text.Trim(_) & \"\"\"\"),",
    "        combined = Text.Combine(quoted, \",\")",
    "    in",
    "        \"{\" & combined & \"}\",",
    "",
    "",
    "    DAXQuery =",
    " \"",
    "",
    "",
    "EVALUATE",
    "SUMMARIZECOLUMNS(",
    "    DEAL[SUB STRATEGY],",
    "    DEAL[DEAL ID],",
    "    DEAL[TRANSACTION TYPE],",
    "    DEAL[TRADE DATE],",
    "    DEAL[START DATE],",
    "    DEAL[END DATE],",
    "    DEAL[PERIOD],",
    "    DEAL[PROFILE],",
    "    DEAL[DEAL_FK],    ",
    "    DEAL[REFERENCE],",
    "    /* Filters */",
    "    KEEPFILTERS(TREATAS({\"\"MANAGEMENT\"\"}, 'REPORT PARAMETER'[VIEW])),",
    "    KEEPFILTERS(TREATAS({\"\"CMT\"\"}, BOOK[DIVISION])),",
    "    ",
    " KEEPFILTERS(",
    "        FILTER(",
    "            VALUES(DEAL[DEAL_FK]),",
    "            NOT ISBLANK(DEAL[DEAL_FK])",
    "        )",
    "    )",
    "",
    "    ,\"\"FULL AMOUNT RC\"\", COUNTROWS(FINANCE)",
    ")",
    "",
    "",
    "\"",
    "in",
    "    DAXQuery"
  ],
  "queryGroup": "Dimension_Functions",
  "lineageTag": "cc725365-ea31-4f59-a802-ece4fefe99be",
