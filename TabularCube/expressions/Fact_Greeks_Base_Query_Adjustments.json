{
  "name": "Fact_Greeks_Base_Query_Adjustments",
  "kind": "m",
  "expression": [
    "(",
    "    pAdjustmentOrNonAdjustment as text,",
    "    pBusinessGroup as text,",
    "    pMaxReportingDate as nullable number,",
    "    DebugStatus as text ,",
    "    RP as text",
    ") as text =>",
    "",
    "let",
    "",
    "    MaxDatePart =",
    "        if pMaxReportingDate = null then",
    "            \"CALCULATE (",
    "                MAX ( 'REPORTING DATE'[ID] ),",
    "                ALL ( 'REPORTING DATE' )",
    "            )\"",
    "        else",
    "            Text.From(pMaxReportingDate),",
    "",
    "    BusinessGroupList =",
    "        let",
    "            items = Text.Split(pBusinessGroup, \",\"),",
    "            quoted = List.Transform(items, each \"\"\"\" & Text.Trim(_) & \"\"\"\"),",
    "            combined = Text.Combine(quoted, \",\")",
    "        in",
    "            \"{\" & combined & \"}\",",
    "",
    "    // Optional debug sample size toggle",
    "    SampleSize =",
    "        if DebugStatus = \"DEBUG\" then",
    "            \"0\"",
    "        else",
    "            \"1000000000\",",
    "",
    "ParttionName = \"GREEKS_00000000_Adjustments\",",
    "",
    "    DAXQuery = \"",
    "",
    "DEFINE",
    "    MEASURE GREEKS[FINAL GREEK VALUE MWH] =",
    "        VAR v = [GREEK VALUE MWH]",
    "        RETURN IF(v <> 0, v)",
    "\tMEASURE GREEKS[FINAL GREEK VALUE RC] =",
    "        VAR v = [GREEK VALUE RC]",
    "        RETURN IF(v <> 0, v)",
    "        ",
    "\tMEASURE GREEKS[FINAL GREEK VALUE CU] =",
    "        VAR v = [GREEK VALUE CU]",
    "        RETURN IF(v <> 0, v)",
    "",
    "",
    "",
    "",
    "EVALUATE",
    "VAR MAINTABLE =",
    "    CALCULATETABLE (",
    "        SUMMARIZECOLUMNS (",
    "            DEAL[DEAL_FK],",
    "            BOOK[BOOK_FK],",
    "            CURVE[CURVE_FK],",
    "            'TIME BUCKET'[TIMEBUCKET_FK],",
    "            CNTPARTY[COUNTERPARTY_FK],",
    "            'NEW BUSINESS'[NEWBUSINESS_FK],",
    "            'REPORTING DATE'[REPORTING_DATE_FK],",
    "            SOURCE[SOURCE_FK],",
    "            REALISATION[REALISATION_FK],",
    "            'REALISATION GROUP'[REALISATION PERIOD],",
    "            UNIT[BUSINESS_KEY],",
    "            UNIT[UNIT],",
    "            \"\"GREEK VALUE MWH\"\", [FINAL GREEK VALUE MWH],",
    "            \"\"GREEK VALUE RC\"\", [FINAL GREEK VALUE RC],",
    "            \"\"GREEK VALUE CU\"\", [FINAL GREEK VALUE CU]",
    "        ),",
    "",
    "        USERELATIONSHIP(",
    "            FINANCE[REPORTING_DATE_FK],",
    "            'REPORTING DATE'[REPORTING_DATE_FK]",
    "        ),",
    "",
    "        USERELATIONSHIP(",
    "            FINANCE[BOOK_FK],",
    "            BOOK[BOOK_FK]",
    "        ),",
    "",
    "       ",
    "        KEEPFILTERS (",
    "            BOOK[DIVISION] = \"\"CMT\"\"",
    "        )",
    "        , KEEPFILTERS( FILTER( ALL( SOURCE[SOURCEGROUP NAME] ), SOURCE[SOURCEGROUP NAME] = \"\"Adjustements\"\" ))",
    "    )",
    "",
    "RETURN",
    "    SELECTCOLUMNS (",
    "        MAINTABLE,",
    "",
    "        \"\"DEAL_FK\"\", DEAL[DEAL_FK],",
    "        \"\"BOOK_FK\"\", BOOK[BOOK_FK],",
    "        \"\"CURVE_FK\"\", CURVE[CURVE_FK],",
    "        \"\"TIMEBUCKET_FK\"\", 'TIME BUCKET'[TIMEBUCKET_FK],",
    "        \"\"COUNTERPARTY_FK\"\", CNTPARTY[COUNTERPARTY_FK],",
    "        \"\"NEWBUSINESS_FK\"\", 'NEW BUSINESS'[NEWBUSINESS_FK],",
    "        \"\"REPORTING_DATE_FK\"\", 'REPORTING DATE'[REPORTING_DATE_FK],",
    "        \"\"UNIT_BUSINESS_KEY\"\" , UNIT[BUSINESS_KEY],",
    "        \"\"SOURCE_FK\"\", SOURCE[SOURCE_FK],",
    "        \"\"REALISATION_FK\"\", REALISATION[REALISATION_FK],",
    "        \"\"REALISATION PERIOD\"\" , 'REALISATION GROUP'[REALISATION PERIOD],",
    "        \"\"GREEK VALUE MWH\"\", [GREEK VALUE MWH],",
    "        \"\"GREEK VALUE RC\"\", [GREEK VALUE RC],",
    "        \"\"GREEK VALUE CU\"\", [GREEK VALUE CU]",
    "",
    "     ,   ",
    "",
    "        \"\"PARTITION_NAME\"\", \"\"\" & ParttionName & \"\"\"  ,",
    "        \"\"EXTRACT_TS\"\", NOW()",
    "",
    "",
    "    )",
    "",
    "",
    "",
    "",
    "    ",
    "",
    "\"",
    "in",
    "    DAXQuery"
  ],
  "queryGroup": "Fact_Finance",
