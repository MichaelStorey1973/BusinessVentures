{
  "name": "Fact_Finance_Base_Query",
  "kind": "m",
  "expression": [
    "(",
    "    pAdjustmentOrNonAdjustment as text,",
    "    pBusinessGroup as text,",
    "    pMaxReportingDate as nullable number,",
    "    DebugStatus as text ,",
    "    RP as text",
    "",
    ") as text =>",
    "",
    "let",
    "",
    "    MaxDatePart =",
    "        if pMaxReportingDate = null then",
    "            \"CALCULATE (",
    "                MAX ( 'REPORTING DATE'[ID] ),",
    "                ALL ( 'REPORTING DATE' )",
    "            )\"",
    "        else",
    "            Text.From(pMaxReportingDate),",
    "",
    "    BusinessGroupList =",
    "        let",
    "            items = Text.Split(pBusinessGroup, \",\"),",
    "            quoted = List.Transform(items, each \"\"\"\" & Text.Trim(_) & \"\"\"\"),",
    "            combined = Text.Combine(quoted, \",\")",
    "        in",
    "            \"{\" & combined & \"}\",",
    "",
    "    // Optional debug sample size toggle",
    "    SampleSize =",
    "        if DebugStatus = \"DEBUG\" then",
    "            \"0\"",
    "        else",
    "            \"1000000000\",",
    "ParttionName = \"FINANCE_\" & RP & \"_\" & Text.From(pMaxReportingDate),",
    "    DAXQuery = \"",
    "",
    "DEFINE",
    "    MEASURE FINANCE[FINAL FULL AMOUNT RC] =",
    "        VAR v = [FULL AMOUNT RC]",
    "        RETURN IF(v <> 0, v)",
    "\tMEASURE FINANCE[FINAL NV DELIVERY RC] =",
    "        VAR v = [NV DELIVERY RC]",
    "        RETURN IF(v <> 0, v)",
    "        ",
    "\tMEASURE FINANCE[FINAL NV DELIVERY CC] =",
    "        VAR v = [NV DELIVERY CC]",
    "        RETURN IF(v <> 0, v)",
    "",
    "MEASURE FINANCE[FINAL VOLUME MWH] =",
    "        VAR v = [VOLUME MWH]",
    "        RETURN IF(v <> 0, v)",
    "",
    "",
    "EVALUATE",
    "VAR MAINTABLE =",
    "    CALCULATETABLE (",
    "        SUMMARIZECOLUMNS (",
    "            DEAL[DEAL_FK],",
    "            BOOK[BOOK_FK],",
    "            CURVE[CURVE_FK],",
    "            'TIME BUCKET'[TIMEBUCKET_FK],",
    "            CNTPARTY[COUNTERPARTY_FK],",
    "            'PAYMENT DATE'[PAYMENT_DATE_FK],",
    "            'NEW BUSINESS'[NEWBUSINESS_FK],",
    "            'CASH FLOW TYPE'[CASHFLOW_TYPE_FK],",
    "            'REPORTING DATE'[REPORTING_DATE_FK],",
    "            SOURCE[SOURCE_FK],",
    "            REALISATION[REALISATION_FK],",
    "            'CONTRACT CURRENCY'[CONTRACT_CURRENCY_FK],",
    "            'CONTRACT CURRENCY'[CONTRACT_CURRENCY],",
    "            'REALISATION GROUP'[REALISATION PERIOD],",
    "            \"\"FULL AMOUNT RC\"\", [FINAL FULL AMOUNT RC],",
    "            \"\"NV DELIVERY RC\"\", [FINAL NV DELIVERY RC],",
    "            \"\"NV DELIVERY CC\"\", [FINAL NV DELIVERY CC],",
    "            \"\"VOLUME MWH\"\", [FINAL VOLUME MWH]",
    "        ),",
    "",
    "        USERELATIONSHIP(",
    "            FINANCE[REPORTING_DATE_FK],",
    "            'REPORTING DATE'[REPORTING_DATE_FK]",
    "        ),",
    "",
    "        USERELATIONSHIP(",
    "            FINANCE[BOOK_FK],",
    "            BOOK[BOOK_FK]",
    "        ),",
    "",
    "        KEEPFILTERS (",
    "            'REPORTING DATE'[ID] = \"&Text.From(pMaxReportingDate)&\"",
    "        ),",
    "        KEEPFILTERS (",
    "            'REALISATION GROUP'[REALISATION PERIOD] =  \"\"\" &  RP & \"\"\"",
    "        ),",
    "",
    "        KEEPFILTERS (",
    "            BOOK[DIVISION] = \"\"CMT\"\"",
    "        )",
    "        , KEEPFILTERS( FILTER( ALL( SOURCE[SOURCEGROUP NAME] ), SOURCE[SOURCEGROUP NAME] <> \"\"Adjustements\"\" ))",
    "    )",
    "",
    "RETURN",
    "    SELECTCOLUMNS (",
    "        MAINTABLE,",
    "",
    "        \"\"DEAL_FK\"\", DEAL[DEAL_FK],",
    "        \"\"BOOK_FK\"\", BOOK[BOOK_FK],",
    "        \"\"CURVE_FK\"\", CURVE[CURVE_FK],",
    "        \"\"TIMEBUCKET_FK\"\", 'TIME BUCKET'[TIMEBUCKET_FK],",
    "        \"\"COUNTERPARTY_FK\"\", CNTPARTY[COUNTERPARTY_FK],",
    "        \"\"PAYMENT_DATE_FK\"\", 'PAYMENT DATE'[PAYMENT_DATE_FK],",
    "        \"\"NEWBUSINESS_FK\"\", 'NEW BUSINESS'[NEWBUSINESS_FK],",
    "        \"\"CASHFLOW_TYPE_FK\"\", 'CASH FLOW TYPE'[CASHFLOW_TYPE_FK],",
    "        \"\"REPORTING_DATE_FK\"\", 'REPORTING DATE'[REPORTING_DATE_FK],",
    "        \"\"SOURCE_FK\"\", SOURCE[SOURCE_FK],",
    "        \"\"REALISATION_FK\"\", REALISATION[REALISATION_FK],",
    "        \"\"CONTRACT_CURRENCY_FK\"\", 'CONTRACT CURRENCY'[CONTRACT_CURRENCY_FK],",
    "        \"\"CONTRACT_CURRENCY\"\", 'CONTRACT CURRENCY'[CONTRACT_CURRENCY],",
    "        \"\"REALISATION PERIOD\"\" , 'REALISATION GROUP'[REALISATION PERIOD],",
    "        \"\"FULL AMOUNT RC\"\", [FULL AMOUNT RC],",
    "        \"\"NV DELIVERY RC\"\", [NV DELIVERY RC],",
    "        \"\"NV DELIVERY CC\"\", [NV DELIVERY CC],",
    "        \"\"VOLUME MWH\"\" , [VOLUME MWH]",
    "",
    "     ,   ",
    "",
    "        \"\"PARTITION_NAME\"\", \"\"\" & ParttionName & \"\"\"  ,",
    "        \"\"EXTRACT_TS\"\", NOW()",
    "",
    "",
    "",
    "    )",
    "",
    "",
    "",
    "",
    "    ",
    "",
    "\"",
    "in",
    "    DAXQuery"
  ],
  "queryGroup": "Fact_Finance",
  "lineageTag": "874d1766-6df2-4b14-83e0-f5b95aa3fa30",
  "annotations": [
    {
      "name": "PBI_NavigationStepName",
      "value": "Navigation"
    },
    {
      "name": "PBI_ResultType",
      "value": "Function"
    }
  ]
}