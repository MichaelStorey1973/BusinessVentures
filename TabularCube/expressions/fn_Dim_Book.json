{
  "name": "fn_Dim_Book",
  "kind": "m",
  "expression": [
    "(",
    "    pAdjustmentOrNonAdjustment as text,",
    "    pBusinessGroup as text,",
    "    pMaxReportingDate as nullable number,",
    "    DebugStatus as text ",
    ") as text =>",
    "",
    "let",
    "    MaxDatePart =",
    "        if pMaxReportingDate = null then",
    "            \"CALCULATE (",
    "                MAX ( 'REPORTING DATE'[ID] ),",
    "                ALL ( 'REPORTING DATE' )",
    "            )\"",
    "        else",
    "            Text.From(pMaxReportingDate),",
    "",
    "    SourceFilterPart =",
    "        if pAdjustmentOrNonAdjustment = \"Adjustements\" then",
    "            \"SOURCE[SOURCEGROUP NAME] = \"\"Adjustements\"\"\"",
    "        else",
    "            \"SOURCE[SOURCEGROUP NAME] <> \"\"Adjustements\"\"\",",
    "",
    "",
    "BusinessGroupList =",
    "    let",
    "        items = Text.Split(pBusinessGroup, \",\"),",
    "        quoted = List.Transform(items, each \"\"\"\" & Text.Trim(_) & \"\"\"\"),",
    "        combined = Text.Combine(quoted, \",\")",
    "    in",
    "        \"{\" & combined & \"}\",",
    "",
    "",
    "    DAXQuery =",
    " \"",
    "",
    "",
    "EVALUATE",
    "SUMMARIZECOLUMNS(",
    "BOOK[BOOK],",
    "BOOK[BUSINESS AREA],",
    "BOOK[BUSINESS GROUP],",
    "BOOK[DIVISION],",
    "BOOK[BUSINESS LINE],",
    "BOOK[STRATEGY],",
    "BOOK[BOOK_FK]",
    "",
    "",
    "     /* Filters */",
    "     ,KEEPFILTERS( TREATAS( {\"\"CMT\"\"}, BOOK[DIVISION] ))",
    "    ,\"\"FULL AMOUNT RC\"\", 0",
    ")",
    "",
    "",
    "\"",
    "in",
    "    DAXQuery"
  ],
  "queryGroup": "Dimension_Functions",
  "lineageTag": "947171c8-dbb8-4661-b7d5-21692f3719d9",
  "annotations": [
    {
      "name": "PBI_NavigationStepName",
      "value": "Navigation"
    },
    {
      "name": "PBI_ResultType",
      "value": "Function"
    }
  ]
}