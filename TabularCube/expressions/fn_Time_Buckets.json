{
  "name": "fn_Time_Buckets",
  "kind": "m",
  "expression": [
    "(",
    "    pAdjustmentOrNonAdjustment as text,",
    "    pBusinessGroup as text,",
    "    pMaxReportingDate as nullable number,",
    "    DebugStatus as text ",
    ") as text =>",
    "",
    "let",
    "    MaxDatePart =",
    "        if pMaxReportingDate = null then",
    "            \"CALCULATE (",
    "                MAX ( 'REPORTING DATE'[ID] ),",
    "                ALL ( 'REPORTING DATE' )",
    "            )\"",
    "        else",
    "            Text.From(pMaxReportingDate),",
    "",
    "    SourceFilterPart =",
    "        if pAdjustmentOrNonAdjustment = \"Adjustements\" then",
    "            \"SOURCE[SOURCEGROUP NAME] = \"\"Adjustements\"\"\"",
    "        else",
    "            \"SOURCE[SOURCEGROUP NAME] <> \"\"Adjustements\"\"\",",
    "",
    "",
    "BusinessGroupList =",
    "    let",
    "        items = Text.Split(pBusinessGroup, \",\"),",
    "        quoted = List.Transform(items, each \"\"\"\" & Text.Trim(_) & \"\"\"\"),",
    "        combined = Text.Combine(quoted, \",\")",
    "    in",
    "        \"{\" & combined & \"}\",",
    "",
    "",
    "    DAXQuery =",
    " \"",
    "",
    "",
    "EVALUATE",
    "SUMMARIZECOLUMNS(",
    "'TIME BUCKET'[TIMEBUCKET_FK],",
    "'TIME BUCKET'[YEAR],",
    "'TIME BUCKET'[QUARTER],",
    "'TIME BUCKET'[MONTH],",
    "'TIME BUCKET'[FISCAL YEAR],",
    "'TIME BUCKET'[FISCIAL QUARTER],",
    "'TIME BUCKET'[FISCIAL MONTH],",
    "    ",
    " KEEPFILTERS(",
    "        FILTER(",
    "            VALUES('TIME BUCKET'[TIMEBUCKET_FK]),",
    "            NOT ISBLANK('TIME BUCKET'[TIMEBUCKET_FK])",
    "        )",
    "    )",
    "",
    "",
    "   ",
    "    ",
    "    ,\"\"FULL AMOUNT RC\"\", 0",
    ")",
    "",
    "",
    "\"",
    "in",
    "    DAXQuery"
  ],
  "queryGroup": "Dimension_Functions",
