    "    DEAL[DEAL ID],",
    "    DEAL[TRANSACTION TYPE],",
    "    DEAL[TRADE DATE],",
    "    DEAL[START DATE],",
    "    DEAL[END DATE],",
    "    DEAL[PERIOD],",
    "    DEAL[PROFILE],",
    "    DEAL[DEAL_FK],    ",
    "    /* Filters */",
    "    KEEPFILTERS(TREATAS({\"\"YTE\"\"}, 'REALISATION GROUP'[REALISATION PERIOD])),",
    "    KEEPFILTERS(TREATAS({\"\"MANAGEMENT\"\"}, 'REPORT PARAMETER'[VIEW])),",
    "    KEEPFILTERS(TREATAS({\"\"CMT\"\"}, BOOK[DIVISION]))",
    "    ",
    "    ,\"\"FULL AMOUNT RC\"\", [FULL AMOUNT RC]",
    ")",
    "",
    "",
    "\"",
    "in",
    "    DAXQuery"
