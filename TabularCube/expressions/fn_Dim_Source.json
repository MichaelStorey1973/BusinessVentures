{
  "name": "fn_Dim_Source",
  "kind": "m",
  "expression": [
    "(",
    "    pAdjustmentOrNonAdjustment as text,",
    "    pBusinessGroup as text,",
    "    pMaxReportingDate as nullable number,",
    "    DebugStatus as text ",
    ") as text =>",
    "",
    "let",
    "    MaxDatePart =",
    "        if pMaxReportingDate = null then",
    "            \"CALCULATE (",
    "                MAX ( 'REPORTING DATE'[ID] ),",
    "                ALL ( 'REPORTING DATE' )",
    "            )\"",
    "        else",
    "            Text.From(pMaxReportingDate),",
    "",
    "    SourceFilterPart =",
    "        if pAdjustmentOrNonAdjustment = \"Adjustements\" then",
    "            \"SOURCE[SOURCEGROUP NAME] = \"\"Adjustements\"\"\"",
    "        else",
    "            \"SOURCE[SOURCEGROUP NAME] <> \"\"Adjustements\"\"\",",
    "",
    "",
    "BusinessGroupList =",
    "    let",
    "        items = Text.Split(pBusinessGroup, \",\"),",
    "        quoted = List.Transform(items, each \"\"\"\" & Text.Trim(_) & \"\"\"\"),",
    "        combined = Text.Combine(quoted, \",\")",
    "    in",
    "        \"{\" & combined & \"}\",",
    "",
    "",
    "    DAXQuery =",
    " \"",
    "",
    "",
    "EVALUATE",
    "SUMMARIZECOLUMNS(",
    "SOURCE[SOURCE_FK],",
    "SOURCE[SOURCEGROUP NAME],",
    "SOURCE[SOURCEGROUP_ID],",
    "SOURCE[SOURCE]",
    ",KEEPFILTERS( TREATAS( {\"\"ENDUR DWH\"\",\"\"Adjustment\"\",\"\"Risk Adjustment\"\"}, SOURCE[SOURCE] ))    ",
    "    ",
    ")",
    "",
    "",
    "\"",
    "in",
    "    DAXQuery"
  ],
  "queryGroup": "Dimension_Functions",
  "lineageTag": "f301ba6a-a1ed-43f7-b45a-f3cfbbd9d57a",
